# ─────────────────────────────────────────────────────────────
# Application settings — copy this to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development       # development | production | test

# ── Database ──────────────────────────────────────────────────
# For local dev with docker-compose, this is pre-configured below.
# For production, use a connection pooler URL (e.g., PgBouncer / Supabase).
DATABASE_URL=postgresql+asyncpg://splitwise:splitwise@localhost:5432/splitwise

# ── Redis ─────────────────────────────────────────────────────
# Used in Prompt 3 for balance caching. Wired but not yet active.
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── AI Feature (Prompt 4) ─────────────────────────────────────
# Get your key at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-CHANGE_ME
CLAUDE_MODEL=claude-sonnet-4-6

# ── Cache (Prompt 3) ──────────────────────────────────────────
BALANCE_CACHE_TTL_SECONDS=300   # 5 minutes; invalidated on write anyway
